# MongoDB (obligatorio). Parámetros recomendados para Atlas inestable:
DATABASE_URL="mongodb+srv://usuario:password@cluster.mongodb.net/p2p?retryWrites=true&w=majority&serverSelectionTimeoutMS=30000&connectTimeoutMS=20000&maxPoolSize=10"

# Seguridad (obligatorio en producción)
APP_ACCESS_PASSWORD="tu-contraseña-de-acceso"
ENCRYPTION_KEY="clave-secreta-de-al-menos-32-caracteres"

# Binance (opcional — proxy si Vercel está geo-bloqueado)
# BINANCE_HTTP_PROXY="http://usuario:pass@host:puerto"
# BINANCE_P2P_HISTORY_MAX_PAGES=2000

# Sync local desde tu PC (opcional)
# SYNC_LOCAL_URL="http://localhost:3000/api/binance/sync"
# SYNC_LOCAL_PASSWORD="misma-que-APP_ACCESS_PASSWORD"

# Sync backfill (opcional, días de historial al sincronizar)
# SYNC_BACKFILL_DAYS=60

# Cron de saldo (Vercel Cron + script local npm run snapshot:wallet)
# En Vercel: Settings → Environment Variables → CRON_SECRET
# Vercel envía Authorization: Bearer CRON_SECRET automáticamente al cron
CRON_SECRET="cambia-este-secreto-largo"
# SNAPSHOT_URL="https://tu-app.vercel.app/api/cron/wallet-balance"
