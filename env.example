# Binance P2P Calculator - Variables de Entorno

# Base de datos MongoDB Atlas
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/binance-p2p-calculator?retryWrites=true&w=majority"

# API de Binance (opcional - la app funciona sin esto)
BINANCE_API_URL="https://api.binance.com/api/v3"

# API de DolarToday para tasa USD/VES (opcional)
DOLARTODAY_API_URL="https://api.dolartoday.com/v1/dolartoday"

# Clave de encriptación para credenciales de Binance (DEBE tener al menos 32 caracteres)
ENCRYPTION_KEY="cambia-esta-clave-por-una-segura-de-al-menos-32-caracteres!!"

# Clave para entrar a la app (mínimo 4 caracteres). Si no se define, no hay pantalla de login.
APP_ACCESS_PASSWORD="tu-clave-secreta-de-acceso"

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME="Binance P2P Calculator"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Configuración de desarrollo
NODE_ENV="development"
